# Copiar a .env y completar. .env esta gitignoreado: nunca commitearlo.
#   cp .env.example .env

# --- Cuenta de admin del juego (se crea en el primer arranque) ---
ADMINUSERNAME=admin
ADMINPASSWORD=cambiame-admin

# --- RCON (puerto 27015, solo localhost) ---
RCONPASSWORD=cambiame-rcon
RCON_PORT=27015

# --- Acceso de los jugadores ---
# Password que tienen que poner los amigos para entrar.
SERVER_PASSWORD=cambiame-server
# Nombre visible del server (Public=false, asi que solo se ve al conectar por IP).
# Los valores con espacios van entre comillas: los scripts hacen "source .env".
PUBLIC_NAME="Mi server de Zomboid"
MAX_PLAYERS=16
# IP publica con la que se conectan los amigos. Solo la usan los avisos de Discord, y solo
# hace falta si no se puede averiguar sola (en la VM la saca de ifconfig.me). Vacia = automatica.
PUBLIC_IP=

# --- Puertos del juego ---
GAME_PORT=16261
GAME_UDP_PORT=16262

# --- Heap de la JVM: la RAM de la maquina menos ~4 GB. 8g con 12 GB, 12g con 16 GB. ---
MIN_MEMORY=2048m
MAX_MEMORY=8g

# --- Mods ---
# Prefijo por Mod ID en la clave Mods= del ini. B42 temprano requeria "\".
# Verificado en 42.20.4: los dos modos cargan igual, se deja vacio (ver docs/mods.md).
# Para usar el prefijo hay que escribirlo asi: MOD_ID_PREFIX="\\"  (comillas dobles;
# .env lo leen dos parsers distintos, bash y docker compose, y solo esa forma les sirve a los dos).
MOD_ID_PREFIX=

# --- Puente nativo de Discord (opcional, Fase 3). Dejar vacio para desactivarlo. ---
DISCORD_ENABLE=false
DISCORD_TOKEN=
DISCORD_CHAT_CHANNEL=
DISCORD_LOG_CHANNEL=
DISCORD_COMMAND_CHANNEL=

# --- Backups (Fase 2). Los lee scripts/backup.sh. ---
# Nombre del remoto de rclone (en la VM lo configura cloud-init como [oci]).
RCLONE_REMOTE=oci
# Bucket de Object Storage. Vacio = backup solo local (es lo normal en la PC de desarrollo).
BACKUP_BUCKET=
# Dias que se guardan los tar locales en backups/. En el bucket la retencion la hace la
# lifecycle rule de OCI (30 dias).
BACKUP_KEEP_LOCAL_DAYS=3

# --- Apagado por inactividad (ver docs/on-demand.md). Lo lee scripts/idle-shutdown.sh. ---
# Minutos con 0 jugadores despues de los cuales la VM se apaga sola (guardando y con backup).
# Se activa con `make idle-shutdown-install`, y solo tiene sentido con el bot de Discord
# andando: sin el, nadie puede volver a prenderla.
IDLE_MINUTES=30

# --- Watchdog: auto-recuperacion del server (ver docs/self-healing.md) ---
# Webhook de un canal de Discord para los avisos del watchdog. Vacio = solo escribe al log.
# ES una credencial: quien la tenga puede postear en ese canal. No commitearla.
DISCORD_WEBHOOK_URL=
# Reinicios automaticos por hora antes de escalar. Mas de 2 es tapar un problema de fondo.
WATCHDOG_MAX_RESTARTS_HOUR=2

# --- Mods al dia con el Workshop (ver docs/mods.md, "Mod updates") ---
# El server baja los mods SOLO al arrancar y Steam los actualiza solos en los clientes: cuando
# un autor publica una version nueva, los que la bajaron dejan de poder entrar hasta que el
# server se reinicie. scripts/mod-updater.sh compara cada 5 minutos y reinicia.
# 1 = reinicia solo. 0 = solo avisa por Discord y deja el reinicio a una persona.
MOD_UPDATE_AUTO_RESTART=1
# Minutos de aviso antes de reiniciar cuando hay gente conectada. Sin nadie adentro reinicia
# en el momento. El ultimo aviso, el de 60 segundos, lo da scripts/stop.sh.
MOD_UPDATE_RESTART_DELAY_MIN=15
# Minutos restantes en los que se manda un recordatorio por el chat del juego. Se pueden poner
# varios separados por espacios ("10 5"); tiene que haber una pasada del timer en ese tramo.
MOD_UPDATE_REMINDERS=5
# Cuanto se espera, despues del reinicio, a que SteamCMD termine de bajar la version nueva
# antes de avisar que no se pudo actualizar.
MOD_UPDATE_VERIFY_SECONDS=900

# --- Avisos de estado en Discord (ver docs/discord.md) ---
# Usan el mismo DISCORD_WEBHOOK_URL de arriba. Publican cuando el server queda activo, cuando
# se apaga y cuando entra o sale alguien.
# 1 = el aviso de "servidor activo" incluye SERVER_PASSWORD, para que los amigos no la tengan
# que pedir. Solo tiene sentido en un canal privado: 0 la deja afuera.
NOTIFIER_INCLUDE_PASSWORD=1

# --- Auto-arreglo con Claude Code (opcional, apagado por default) ---
# 1 = cuando el watchdog no puede solo, le pasa el diagnostico a Claude Code en modo headless.
# Leer la seccion de riesgos de docs/self-healing.md antes de prenderlo.
CLAUDE_AUTOREPAIR=0
# Cupo diario de invocaciones (ademas de un maximo de una por hora).
AUTOREPAIR_MAX_PER_DAY=3
# Una de las dos credenciales, no las dos. La API key factura por uso; el token de OAuth
# (lo genera 'claude setup-token') usa la suscripcion y dura alrededor de un ano.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# =============================================================================================
# Bot de Discord: SOLO EN LA INSTANCIA DEL BOT (ver docs/on-demand.md)
# =============================================================================================
# Nada de esto va en el .env de la VM del juego. Vive en /etc/pz-bot/env dentro de la instancia
# del bot, lo escribe cloud-init desde terraform.tfvars y lo lee infra/systemd/pz-bot.service.
# Se listan aca para tenerlas documentadas en un solo lugar.
#
# Token del bot (Developer Portal -> Bot -> Reset Token). ES una credencial.
# DISCORD_BOT_TOKEN=
# ID del servidor de Discord: con el los comandos /pz aparecen al instante.
# PZ_BOT_GUILD_ID=
# Instancia del JUEGO, que es la que el bot prende y apaga.
# PZ_INSTANCE_OCID=
# PZ_GAME_IP=
# PZ_GAME_PORT=16261
# Vacias = cualquier miembro del servidor de Discord. Con 0 jugadores igual es la unica
# condicion para /pz stop: la lista de admins se suma, no la reemplaza.
# PZ_BOT_ADMIN_USER_IDS=
# PZ_BOT_ALLOWED_ROLE_IDS=
# instance_principal (en la instancia del bot) o config (para probarlo desde la PC del admin).
# PZ_BOT_OCI_AUTH=instance_principal
