# Copiar a .env y completar. .env esta gitignoreado: nunca commitearlo.
#   cp .env.example .env

# --- Cuenta de admin del juego (se crea en el primer arranque) ---
ADMINUSERNAME=admin
ADMINPASSWORD=cambiame-admin

# --- RCON (puerto 27015, solo localhost) ---
RCONPASSWORD=cambiame-rcon
RCON_PORT=27015

# --- Acceso de los jugadores ---
# Password que tienen que poner los amigos para entrar.
SERVER_PASSWORD=cambiame-server
# Nombre visible del server (Public=false, asi que solo se ve al conectar por IP).
# Los valores con espacios van entre comillas: los scripts hacen "source .env".
PUBLIC_NAME="Mi server de Zomboid"
MAX_PLAYERS=16

# --- Puertos del juego ---
GAME_PORT=16261
GAME_UDP_PORT=16262

# --- Heap de la JVM. 8g para 8 jugadores, 12g para 16. ---
MIN_MEMORY=2048m
MAX_MEMORY=8g

# --- Mods ---
# Prefijo por Mod ID en la clave Mods= del ini. B42 temprano requeria "\".
# Verificado en 42.20.4: los dos modos cargan igual, se deja vacio (ver docs/mods.md).
# Para usar el prefijo hay que escribirlo asi: MOD_ID_PREFIX="\\"  (comillas dobles;
# .env lo leen dos parsers distintos, bash y docker compose, y solo esa forma les sirve a los dos).
MOD_ID_PREFIX=

# --- Puente nativo de Discord (opcional, Fase 3). Dejar vacio para desactivarlo. ---
DISCORD_ENABLE=false
DISCORD_TOKEN=
DISCORD_CHAT_CHANNEL=
DISCORD_LOG_CHANNEL=
DISCORD_COMMAND_CHANNEL=

# --- Backups (Fase 2). Los lee scripts/backup.sh. ---
# Nombre del remoto de rclone (en la VM lo configura cloud-init como [oci]).
RCLONE_REMOTE=oci
# Bucket de Object Storage. Vacio = backup solo local (es lo normal en la PC de desarrollo).
BACKUP_BUCKET=
# Dias que se guardan los tar locales en backups/. En el bucket la retencion la hace la
# lifecycle rule de OCI (30 dias).
BACKUP_KEEP_LOCAL_DAYS=3

# --- Apagado por inactividad (Fase 3, todavia sin cron). Lo lee scripts/idle-shutdown.sh. ---
IDLE_MINUTES=30
