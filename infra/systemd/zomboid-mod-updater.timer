# Dispara zomboid-mod-updater.service cada 5 minutos.
#
# Por que 5 y no 10: la cuenta regresiva se resuelve por tiempo restante, no por numero de
# pasada, asi que el intervalo solo fija el error maximo del aviso. Con 5 minutos, entre el
# aviso inicial (15 min) y el reinicio siempre cae al menos una pasada con 5 minutos o menos
# restantes, que es el recordatorio del medio; el ultimo aviso, el de 1 minuto, no lo da este
# timer sino scripts/stop.sh, que avisa 60 segundos antes de guardar. Con 10 minutos ese
# recordatorio del medio se perderia la mitad de las veces, y la alternativa —dormir dentro de
# la corrida— dejaria el lock compartido tomado y el watchdog mudo justo durante la espera.
#
# El costo es una llamada anonima a la API de Steam cada 5 minutos por ~30 items, que es una
# sola request.
[Unit]
Description=Chequeo periodico de actualizaciones de mods (Workshop)
Documentation=https://github.com/lucbece/zomboid-server

[Timer]
# Seis minutos despues del boot: despues del primer chequeo del watchdog y con el server ya
# arrancado, para no comparar contra un .acf a medio escribir.
OnBootSec=6min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
AccuracySec=15s
Unit=zomboid-mod-updater.service

[Install]
WantedBy=timers.target
